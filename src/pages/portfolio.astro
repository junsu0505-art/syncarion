---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const cases = [
  {
    name: 'HQ — AI 에이전트 조직',
    tag: '자체 · 상시 운영',
    desc:
      '부서장 14명 편제, 훅 기반 행동 강제, 웹 관제(Cockpit)까지 갖춘 1인 AI 회사. 자율 7회차로 도구를 완성하고 31개 저장소를 자체 전수 감사.',
    nums: ['에이전트 28 · 훅 16', '감사 발견 369건'],
  },
  {
    name: '마케팅 대행사 A 백오피스',
    tag: '외주 · Forward-Deployed',
    desc:
      '1.4만 행 수기 시트 운영을 전수 분석으로 진단, 2주 만에 작동 화면 3개로 대체. 폐쇄망 이관 납품까지.',
    nums: ['14,824행 이관', '구축 2주 · 화면 3'],
  },
  {
    name: '물류업체 B ERP',
    tag: '외주 · 전주기',
    desc:
      '직원 ~70인 물류업체의 로그인·권한부터 재고·매출·세금관리까지 — 돈이 걸린 전 모듈을 Python + PostgreSQL로 구축.',
    nums: ['모듈 4계열', '~70인 조직'],
  },
  {
    name: 'Decision Lab',
    tag: '자체 SaaS · 운영 중',
    desc:
      '포트폴리오 스크린샷 → AI 자산배분·리스크 코칭. 종목 추천 금지를 제품 헌법으로. 설계→구축→인시던트 대응→상용화 전 주기 1인 수행.',
    nums: ['200+ 파일', '28,000+ 줄'],
  },
  {
    name: '데이터 파이프라인',
    tag: '자체 · 24/7',
    desc:
      '수집·연구·집행을 물리 분리하고 스키마 계약으로만 연결. 매일 아침 사람 없이 연쇄 실행, 실패 시 하류 자동 차단, fail-closed 집행.',
    nums: ['3계층 분리', '테스트 221'],
  },
  {
    name: 'LLM Wiki + 온톨로지',
    tag: '자체 · 지식 인프라',
    desc:
      '산출물이 자동으로 위키 카드가 되고 관계 그래프로 연결. 하이브리드 검색(BM25+임베딩), 증거 게이트, 린트 상시 감시.',
    nums: ['262노드 · 1,523엣지', '끊어진 링크 0'],
  },
  {
    name: '네이버 홈페이지형 블로그 빌더',
    tag: '제품화된 외주',
    desc:
      '블로그를 홈페이지형 대문으로 바꾸는 1-click 빌더. 측정-후-렌더로 어떤 블로그든 자동 적응, config 1개 = 블로그 1개.',
    nums: ['적용 재비용 ≈ 0'],
  },
  {
    name: 'AI/AX 교육',
    tag: '교육 · 이식',
    desc:
      '비개발자 4주 부트캠프 + Claude 심화 10모듈. 수강생에게 실작동 미니 AI 조직(스타터 킷)을 배포 — 지식이 아니라 시스템이 남게.',
    nums: ['10모듈 커리큘럼', '스타터 킷 배포'],
  },
];

const principles = [
  { t: '진단은 실데이터 전수로', d: '인터뷰가 아니라 원본을 내려받아 분석하는 것에서 시작합니다.' },
  { t: '규칙은 역산으로 증명 후 코드로', d: '기존 수기 계산을 재현해 일치를 확인하기 전에는 시스템화하지 않습니다.' },
  { t: '경계는 구조로 강제', d: '법·약관·권한 경계는 운영 수칙이 아니라 아키텍처 불변식으로 박습니다.' },
  { t: 'fail-closed', d: '돈이 걸린 시스템은 불확실할 때 멈추는 것이 정상 동작입니다.' },
  { t: '인수 가능한 납품', d: '받은 쪽이 유지·운영할 수 없는 납품은 납품이 아닙니다.' },
  { t: '자기 사용이 최고의 검증', d: '제안하는 모든 구조는 본인 사업에서 먼저 상시 가동합니다.' },
];
---

<BaseLayout
  title="포트폴리오 — Syncarion"
  description="AI/AX를 교육하고, 직접 구축해서, 스스로 사용합니다. Syncarion의 케이스 스터디와 일하는 원칙."
>
  <Header />

  <main class="pf">
    <div class="container">
      <header class="pf-hero">
        <div class="section-label">AI / AX Portfolio</div>
        <h1>AI/AX를 교육하고, 직접 구축해서,<br><em>스스로 사용합니다</em></h1>
        <p>
          Syncarion은 대표 1인과 부서장 14명의 AI 에이전트 조직으로 운영되는
          AI/AX 회사입니다. 자기 사업 전체(SaaS·외주 구축·교육·콘텐츠)를 이 조직이
          수행하며, 고객에게 제안하는 모든 구조는 우리 사업에서 먼저 상시 가동합니다.
        </p>
      </header>

      <section class="pf-section">
        <div class="section-label">Selected Work</div>
        <h2 class="section-title">케이스 하이라이트</h2>
        <div class="pf-grid">
          {cases.map((c) => (
            <article class="pf-card">
              <div class="pf-tag">{c.tag}</div>
              <h3>{c.name}</h3>
              <p>{c.desc}</p>
              <div class="pf-nums">{c.nums.map((n) => <span>{n}</span>)}</div>
            </article>
          ))}
        </div>
      </section>

      <section class="pf-section">
        <div class="section-label">Evidence</div>
        <h2 class="section-title">말이 아니라 화면으로</h2>
        <div class="pf-shots">
          <figure>
            <img src="/portfolio/cockpit-overview.png" alt="HQ Cockpit 라이브 관제 화면" loading="lazy" />
            <figcaption>HQ Cockpit — AI 조직 라이브 관제. 세션 8개 동시 가동, 부서장 편제·토큰 소모가 한 화면에.</figcaption>
          </figure>
          <figure>
            <img src="/portfolio/wiki-ontology-graph.png" alt="지식그래프 실측 렌더" loading="lazy" />
            <figcaption>지식그래프 실측 렌더 — 위키 카드 271장 중 온톨로지 등재 262노드 / 1,523엣지.</figcaption>
          </figure>
        </div>
      </section>

      <section class="pf-section">
        <div class="section-label">Principles</div>
        <h2 class="section-title">일하는 원칙</h2>
        <div class="pf-principles">
          {principles.map((p) => (
            <div class="pf-p"><b>{p.t}</b><span>{p.d}</span></div>
          ))}
        </div>
      </section>

      <section class="pf-cta">
        <h2>다음 케이스는 당신의 시스템입니다</h2>
        <a href="/#contact" class="btn-primary">무료 진단 상담 →</a>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .pf { padding-top: 120px; }

  .pf-hero { padding: 48px 0 24px; max-width: 760px; }
  .pf-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 400;
    line-height: 1.2;
    margin: 12px 0 20px;
  }
  .pf-hero h1 em { font-style: italic; color: var(--color-accent); }
  .pf-hero p { color: var(--color-text-dim); }

  .pf-section { padding: 64px 0 0; }

  .pf-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 32px;
  }
  .pf-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 24px 26px;
    transition: border-color 0.3s;
  }
  .pf-card:hover { border-color: var(--color-accent); }
  .pf-tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .pf-card h3 {
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 8px;
  }
  .pf-card p { font-size: 0.86rem; color: var(--color-text-dim); margin-bottom: 14px; }
  .pf-nums { display: flex; gap: 8px; flex-wrap: wrap; }
  .pf-nums span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
    background: var(--color-accent-dim);
    border-radius: 6px;
    padding: 4px 10px;
  }

  .pf-shots { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 32px; }
  .pf-shots figure {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }
  .pf-shots img { width: 100%; display: block; }
  .pf-shots figcaption {
    padding: 12px 16px;
    font-size: 0.76rem;
    color: var(--color-text-dim);
    border-top: 1px solid var(--color-border);
  }

  .pf-principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 32px;
  }
  .pf-p { border-left: 2px solid var(--color-accent); padding: 4px 0 4px 16px; }
  .pf-p b { display: block; font-weight: 500; font-size: 0.92rem; margin-bottom: 4px; }
  .pf-p span { font-size: 0.8rem; color: var(--color-text-dim); }

  .pf-cta {
    text-align: center;
    padding: 96px 0 120px;
  }
  .pf-cta h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 400;
    margin-bottom: 28px;
  }

  @media (max-width: 820px) {
    .pf-grid, .pf-shots { grid-template-columns: 1fr; }
    .pf-principles { grid-template-columns: 1fr; }
  }
</style>
